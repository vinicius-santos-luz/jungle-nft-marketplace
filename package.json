{
  "name": "jungle-nft-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:update": "playwright test --update-snapshots",
    "audit:mobile": "lighthouse http://localhost:4173/ --output=html --output=json --output-path=./audits/mobile-home --chrome-flags='--headless --no-sandbox'",
    "audit:desktop": "lighthouse http://localhost:4173/ --preset=desktop --output=html --output=json --output-path=./audits/desktop-home --chrome-flags='--headless --no-sandbox'",
    "audit:detail:mobile": "lighthouse http://localhost:4173/nft/nft-1 --output=html --output=json --output-path=./audits/mobile-detail --chrome-flags='--headless --no-sandbox'",
    "audit:detail:desktop": "lighthouse http://localhost:4173/nft/nft-1 --preset=desktop --output=html --output=json --output-path=./audits/desktop-detail --chrome-flags='--headless --no-sandbox'"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lighthouse": "^13.6.0",
    "msw": "^2.15.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
